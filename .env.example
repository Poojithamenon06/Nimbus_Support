# Optional. If you set a real key here, the assistant will use Claude to write a
# natural-language answer grounded in the retrieved knowledge-base article.
# If you leave this blank, the app still works fully — it will show the
# matched article's content directly instead (pure retrieval, no generation).
ANTHROPIC_API_KEY=

# Confidence threshold (0-1). Below this, a ticket is escalated to a human.
CONFIDENCE_THRESHOLD=0.28
